{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "background.schema.json",
  "title": "Hearth community background",
  "description": "`data` mirrors one entry of Hearth's BACKGROUNDS registry: { name, skills, gold, equipment, feature }.",
  "allOf": [
    { "$ref": "common.schema.json" },
    {
      "properties": {
        "type": { "const": "background" },
        "data": {
          "type": "object",
          "required": ["name", "skills", "gold", "equipment", "feature"],
          "properties": {
            "name": { "type": "string" },
            "skills": { "type": "array", "minItems": 2, "maxItems": 2, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/skill" } },
            "gold": { "type": "integer", "minimum": 0, "maximum": 50 },
            "equipment": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "feature": { "$ref": "common.schema.json#/$defs/feature" }
          }
        }
      }
    }
  ]
}
