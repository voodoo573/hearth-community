{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "feat.schema.json",
  "title": "Hearth community feat",
  "description": "`data` mirrors one entry of Hearth's FEATS array: { id, name, desc, hpPerLevel? }, plus optional prerequisite and ability text.",
  "allOf": [
    { "$ref": "common.schema.json" },
    {
      "properties": {
        "type": { "const": "feat" },
        "data": {
          "type": "object",
          "required": ["id", "name", "desc"],
          "properties": {
            "id": { "$ref": "common.schema.json#/$defs/key" },
            "name": { "type": "string" },
            "desc": { "type": "string", "maxLength": 3000 },
            "prerequisite": { "type": "string", "maxLength": 200 },
            "hpPerLevel": { "type": "integer", "minimum": 1, "maximum": 3 }
          }
        }
      }
    }
  ]
}
