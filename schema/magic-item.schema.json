{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "magic-item.schema.json",
  "title": "Hearth community magic item",
  "description": "`data` mirrors the item Hearth's Magic Item Forge stores in its homebrew list (app/index.html: saveForgeMagicItem() stores { type:'magic_item', title, data }, and injectHomebrewMagicItemsIntoRegistry() copies data into MAGIC_ITEMS). Shape: { id, name, type, rarity, attune, desc, mech, theme?, templateId?, resist?, charges? | perDay? }, the same as emptyMagicItemDraft().",
  "allOf": [
    {
      "$ref": "common.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "magic-item"
        },
        "data": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "name",
            "type",
            "rarity",
            "attune",
            "desc",
            "mech"
          ],
          "properties": {
            "id": {
              "$ref": "common.schema.json#/$defs/key",
              "description": "snake_case MAGIC_ITEMS key, usually the item id with '-' replaced by '_'."
            },
            "name": {
              "type": "string",
              "minLength": 3,
              "maxLength": 60
            },
            "type": {
              "enum": [
                "weapon",
                "armor",
                "shield",
                "ring",
                "wondrous",
                "potion",
                "scroll",
                "wand",
                "staff",
                "rod"
              ],
              "description": "A MAGIC_ITEM_TYPES key."
            },
            "rarity": {
              "enum": [
                "common",
                "uncommon",
                "rare",
                "very_rare",
                "legendary",
                "artifact"
              ],
              "description": "A MAGIC_ITEM_RARITIES key."
            },
            "attune": {
              "type": "boolean"
            },
            "desc": {
              "type": "string",
              "minLength": 10,
              "maxLength": 3000
            },
            "mech": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "attackBonus": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    },
                    "damageBonus": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    },
                    "acBonus": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    },
                    "saveBonus": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    },
                    "spellAttackBonus": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3
                    },
                    "spellDcBonus": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 3,
                      "description": "Bonus to spell save DC. spellAttackBonus no longer raises the DC (Hearth v0.92.1), so set this only when the item grants it."
                    },
                    "hpBonus": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 50
                    },
                    "resistType": {
                      "$ref": "common.schema.json#/$defs/damageType",
                      "description": "Older form of the top-level resist field; Hearth still honours it. Prefer data.resist."
                    },
                    "weapon": {
                      "type": "string",
                      "pattern": "^[a-z][a-z_ ]*$",
                      "description": "The weapon the item's attackBonus/damageBonus belongs to, e.g. \"quarterstaff\" (Hearth 1.1.1 applies those bonuses only to that weapon; staffs default to quarterstaff)."
                    }
                  }
                }
              ],
              "description": "Mechanical bonuses Hearth applies automatically, or null for text-only items. spellAttackBonus is spell attack rolls only; spellDcBonus is spell save DC only."
            },
            "theme": {
              "enum": [
                "shadow",
                "fire",
                "frost",
                "storm",
                "nature",
                "holy",
                "arcane",
                "blood",
                "trickster",
                "void"
              ],
              "description": "Optional FORGE_THEMES key."
            },
            "templateId": {
              "type": [
                "string",
                "null"
              ]
            },
            "resist": {
              "anyOf": [
                {
                  "$ref": "common.schema.json#/$defs/damageType"
                },
                {
                  "const": "choice"
                }
              ],
              "description": "Damage resistance Hearth applies while the item is active (equipped/attuned as required): one damage type, or \"choice\" for a resistance the player picks. Hearth v0.92.1+."
            },
            "charges": {
              "anyOf": [
                {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 100
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "max"
                  ],
                  "properties": {
                    "max": {
                      "type": "integer",
                      "minimum": 1,
                      "maximum": 100
                    },
                    "recharge": {
                      "type": "string",
                      "maxLength": 80,
                      "description": "When charges come back, e.g. \"1d6+4 at dawn\", \"all on a short or long rest\". Hearth resets on a short rest if the text says short, a long rest if it says long, otherwise at dawn; leading dice become the amount regained (otherwise all)."
                    },
                    "regain": {
                      "type": [
                        "string",
                        "integer"
                      ],
                      "description": "Optional explicit amount regained, e.g. \"1d3\". Defaults to the dice at the start of recharge, or all."
                    }
                  }
                }
              ],
              "description": "Charges Hearth tracks for the item (Hearth v0.92.1+). A number is shorthand for { max } recharging at dawn."
            },
            "perDay": {
              "type": "integer",
              "minimum": 1,
              "maximum": 20,
              "description": "Uses per day for items without charges; Hearth tracks them like charges that all return at dawn. Use charges instead when both would apply."
            }
          }
        }
      }
    }
  ]
}
