{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "spell.schema.json",
  "title": "Hearth community spell",
  "description": "`data` mirrors one entry of Hearth's SPELLS array: { name, level, school, classes, time, range, components, duration, desc, kind, save?, damageType?, concentration?, ritual?, dice?, scaleType?, scaleAt? }.",
  "allOf": [
    { "$ref": "common.schema.json" },
    {
      "properties": {
        "type": { "const": "spell" },
        "data": {
          "type": "object",
          "required": ["name", "level", "school", "classes", "time", "range", "components", "duration", "desc", "kind"],
          "properties": {
            "name": { "type": "string" },
            "level": { "type": "integer", "minimum": 0, "maximum": 9 },
            "school": { "enum": ["abjuration", "conjuration", "divination", "enchantment", "evocation", "illusion", "necromancy", "transmutation"] },
            "classes": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "$ref": "common.schema.json#/$defs/klass" } },
            "time": { "type": "string", "description": "'action', 'bonus_action', 'reaction', or free text like '1 minute'" },
            "range": { "type": "string" },
            "components": { "type": "string", "pattern": "^V?(, )?S?(, )?M?( \\(.*\\))?$" },
            "duration": { "type": "string" },
            "desc": { "type": "string", "maxLength": 3000 },
            "kind": { "enum": ["attack", "save", "heal", "auto", "utility"] },
            "save": { "$ref": "common.schema.json#/$defs/ability" },
            "damageType": { "enum": ["acid", "bludgeoning", "cold", "fire", "force", "lightning", "necrotic", "piercing", "poison", "psychic", "radiant", "slashing", "thunder"] },
            "concentration": { "type": "boolean" },
            "ritual": { "type": "boolean" },
            "dice": {
              "type": "object", "required": ["count", "sides"], "additionalProperties": false,
              "properties": {
                "count": { "type": "integer", "minimum": 1, "maximum": 40 },
                "sides": { "enum": [4, 6, 8, 10, 12, 20] },
                "bonus": { "type": "integer" },
                "modAbility": { "const": "spellcasting" }
              }
            },
            "scaleType": { "enum": ["cantrip", "slot"] },
            "scaleAt": {
              "type": "object", "additionalProperties": false,
              "description": "What grows per step: per cantrip tier (5/11/17) or per slot level above the spell's level.",
              "properties": {
                "dice": { "type": "integer", "minimum": 1 },
                "extraTargets": { "type": "integer", "minimum": 1 },
                "darts": { "type": "integer", "minimum": 1 }
              }
            }
          }
        }
      }
    }
  ]
}
