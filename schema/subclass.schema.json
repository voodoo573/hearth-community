{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "subclass.schema.json",
  "title": "Hearth community subclass",
  "description": "`data` mirrors the shape Hearth's Subclass Forge stores for homebrew subclasses (loadAiHomebrew entries with type 'subclass', injected into SUBCLASSES[klass][id] by injectHomebrewSubclassesIntoRegistry): { klass, id, name, desc, levelFeatures }.",
  "allOf": [
    {
      "$ref": "common.schema.json"
    },
    {
      "properties": {
        "type": {
          "const": "subclass"
        },
        "data": {
          "type": "object",
          "required": [
            "klass",
            "id",
            "name",
            "desc",
            "levelFeatures"
          ],
          "properties": {
            "klass": {
              "$ref": "common.schema.json#/$defs/klass",
              "description": "Parent class key"
            },
            "id": {
              "$ref": "common.schema.json#/$defs/key",
              "description": "snake_case registry key, conventionally the item id with - replaced by _"
            },
            "name": {
              "type": "string"
            },
            "desc": {
              "type": "string",
              "maxLength": 600
            },
            "levelFeatures": {
              "type": "object",
              "description": "Keyed by class level (\"1\" to \"20\"), each an array of { name, desc, effects? } features.",
              "patternProperties": {
                "^([1-9]|1[0-9]|20)$": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "required": [
                      "name",
                      "desc"
                    ],
                    "properties": {
                      "name": {
                        "type": "string"
                      },
                      "desc": {
                        "type": "string"
                      },
                      "effects": {
                        "type": "array",
                        "description": "Optional structured Forge effects. Explicit effects win; Hearth 1.1.1 also infers some effects from the rules text when a feature has none of that kind. Kinds Hearth applies: 'grant_spells' {spells, ability}; 'skill' {skill, level: 'prof'|'expertise'}; 'skill_choice' {options: [skills], count, level?}; 'proficiency' {tools?, weapons?, armor?}; 'active' {cost: 'action'|'bonus'|'reaction'|'none'|'triggered'|'channel_divinity', uses: number|'pb'|ability|'unlimited', reset: 'short'|'long', saveAbility?, dc?: 'spell'|ability, ki?: N, option? (Channel Divinity option name), desc?}; 'resist' {dtype}; 'rider' {count, sides, dtype, freq: 'once_per_turn'|'each_hit', scale?: {level: count | {count, sides}}}; 'smite' {dtypes, vs}; 'second_wind' {uses?, addCon?}; 'unarmed' {count, sides, dtype, ability, when: 'always'|'rage'|'feature', scale?: {level: {count?, sides?}}, extra?: {dtype, half, fullAt}, note?}; 'speed' {amount} (walking bonus) or {type: 'climb'|'swim'|'fly'|'burrow', amount: feet|'walk'}; 'ac' {amount}; 'extra_attack'. 'active' may also carry duration and rider {count, sides, dtype} (a timed state), and dc 'text' with dcText or dc 'none'. Any effect may carry minLevel (class level it starts at). Unknown kinds are ignored by Hearth.",
                        "items": {
                          "type": "object",
                          "required": [
                            "kind"
                          ],
                          "properties": {
                            "kind": {
                              "enum": [
                                "grant_spells",
                                "skill",
                                "skill_choice",
                                "proficiency",
                                "active",
                                "resist",
                                "rider",
                                "smite",
                                "second_wind",
                                "unarmed",
                                "speed",
                                "ac",
                                "extra_attack",
                                "passive"
                              ]
                            },
                            "uses": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 20
                                },
                                {
                                  "enum": [
                                    "pb",
                                    "unlimited",
                                    "str",
                                    "dex",
                                    "con",
                                    "int",
                                    "wis",
                                    "cha"
                                  ]
                                }
                              ],
                              "description": "A number, 'pb', an ability name ('wis' = that modifier, minimum 1) or 'unlimited' (no counter)."
                            },
                            "tools": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "weapons": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "armor": {
                              "type": "array",
                              "items": {
                                "type": "string"
                              }
                            },
                            "cost": {
                              "enum": [
                                "action",
                                "bonus",
                                "reaction",
                                "none",
                                "triggered",
                                "channel_divinity"
                              ]
                            },
                            "reset": {
                              "enum": [
                                "short",
                                "long"
                              ]
                            },
                            "saveAbility": {
                              "enum": [
                                "str",
                                "dex",
                                "con",
                                "int",
                                "wis",
                                "cha",
                                "",
                                "none"
                              ]
                            },
                            "dc": {
                              "enum": [
                                "spell",
                                "text",
                                "none",
                                "str",
                                "dex",
                                "con",
                                "int",
                                "wis",
                                "cha"
                              ],
                              "description": "DC source for saveAbility: 'spell' (your spell save DC), an ability (8 + proficiency bonus + modifier), 'text' (show dcText, e.g. '5 + the damage taken') or 'none' (no DC)."
                            },
                            "ki": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 20,
                              "description": "Ki points the feature costs (spent from the ki pool, no separate counter)."
                            },
                            "option": {
                              "type": "string",
                              "maxLength": 60,
                              "description": "Channel Divinity option name (cost 'channel_divinity')."
                            },
                            "desc": {
                              "type": "string",
                              "maxLength": 600
                            },
                            "dtype": {
                              "$ref": "common.schema.json#/$defs/damageType"
                            },
                            "dtypes": {
                              "type": "array",
                              "minItems": 1,
                              "items": {
                                "$ref": "common.schema.json#/$defs/damageType"
                              },
                              "description": "smite: damage types the player can pick for Divine Smite."
                            },
                            "vs": {
                              "type": [
                                "string",
                                "null"
                              ],
                              "maxLength": 80,
                              "description": "smite: the creatures that take the extra 1d8 (replaces 'undead or fiend')."
                            },
                            "addCon": {
                              "type": "boolean",
                              "description": "second_wind: add your Constitution modifier to the healing."
                            },
                            "options": {
                              "type": "array",
                              "minItems": 2,
                              "items": {
                                "$ref": "common.schema.json#/$defs/skill"
                              }
                            },
                            "count": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 20
                            },
                            "sides": {
                              "type": "integer",
                              "minimum": 2,
                              "maximum": 20
                            },
                            "ability": {
                              "$ref": "common.schema.json#/$defs/ability"
                            },
                            "when": {
                              "enum": [
                                "always",
                                "rage",
                                "feature"
                              ]
                            },
                            "scale": {
                              "type": "object",
                              "patternProperties": {
                                "^([1-9]|1[0-9]|20)$": {
                                  "anyOf": [
                                    {
                                      "type": "integer",
                                      "minimum": 1,
                                      "maximum": 20
                                    },
                                    {
                                      "type": "object",
                                      "additionalProperties": false,
                                      "properties": {
                                        "count": {
                                          "type": "integer",
                                          "minimum": 1,
                                          "maximum": 20
                                        },
                                        "sides": {
                                          "type": "integer",
                                          "minimum": 2,
                                          "maximum": 20
                                        }
                                      }
                                    }
                                  ]
                                }
                              },
                              "additionalProperties": false,
                              "description": "Dice at higher class levels, keyed by level: rider {\"14\": 2} or {\"14\": {count, sides}}; unarmed {\"10\": {\"sides\": 8}}."
                            },
                            "extra": {
                              "type": "object",
                              "additionalProperties": false,
                              "properties": {
                                "dtype": {
                                  "$ref": "common.schema.json#/$defs/damageType"
                                },
                                "half": {
                                  "type": "boolean"
                                },
                                "fullAt": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 20
                                }
                              },
                              "description": "unarmed: extra damage equal to your proficiency bonus (half: half of it until fullAt)."
                            },
                            "type": {
                              "enum": [
                                "walk",
                                "climb",
                                "swim",
                                "fly",
                                "burrow"
                              ]
                            },
                            "amount": {
                              "anyOf": [
                                {
                                  "type": "integer",
                                  "minimum": -30,
                                  "maximum": 120
                                },
                                {
                                  "const": "walk"
                                }
                              ]
                            },
                            "minLevel": {
                              "type": "integer",
                              "minimum": 1,
                              "maximum": 20
                            },
                            "freq": {
                              "enum": [
                                "once_per_turn",
                                "each_hit"
                              ]
                            },
                            "level": {
                              "enum": [
                                "prof",
                                "expertise"
                              ]
                            },
                            "dcText": {
                              "type": "string",
                              "maxLength": 60,
                              "description": "With dc 'text': the rules' own DC formula."
                            },
                            "duration": {
                              "type": "string",
                              "maxLength": 40,
                              "description": "active: how long it lasts once used, e.g. '1 minute'. Hearth 1.1.2+ shows it as a timed state."
                            },
                            "rider": {
                              "type": "object",
                              "additionalProperties": false,
                              "required": [
                                "sides"
                              ],
                              "properties": {
                                "count": {
                                  "type": "integer",
                                  "minimum": 1,
                                  "maximum": 20
                                },
                                "sides": {
                                  "type": "integer",
                                  "minimum": 2,
                                  "maximum": 20
                                },
                                "dtype": {
                                  "$ref": "common.schema.json#/$defs/damageType"
                                }
                              },
                              "description": "active: extra damage on every weapon hit while its timed state is on (e.g. Roaring Fire's +1d6 fire)."
                            },
                            "spells": {
                              "type": "array",
                              "items": {
                                "anyOf": [
                                  {
                                    "type": "string"
                                  },
                                  {
                                    "type": "object",
                                    "required": [
                                      "name"
                                    ],
                                    "properties": {
                                      "name": {
                                        "type": "string"
                                      }
                                    }
                                  }
                                ]
                              },
                              "description": "grant_spells: spell names (must match a Hearth or community spell exactly), or objects with { name, level, school, castTime, range, components, duration, desc } for a spell Hearth doesn't have."
                            }
                          }
                        }
                      },
                      "infer": {
                        "type": "boolean",
                        "description": "false stops Hearth (1.1.2+) reading extra effects from this feature's text. An explicit empty effects list does the same."
                      }
                    }
                  }
                }
              },
              "additionalProperties": false
            }
          }
        }
      }
    }
  ]
}
